<div class="assignfeedback-aifeedback" data-region="assignfeedback-aifeedback" data-cmid="{{cmid}}" data-userid="{{userid}}" data-generating-label="{{generatinglabel}}" data-token-count-label="{{tokencountlabel}}">
    {{#eligible}}
    <button type="button" class="btn btn-outline-primary" data-action="open-modal">{{buttonlabel}}</button>
    {{/eligible}}

    {{^eligible}}
    <button type="button" class="btn btn-outline-secondary" disabled title="{{reason}}">{{buttonlabel}}</button>
    <small class="text-muted d-block mt-1">{{reason}}</small>
    {{/eligible}}

    <div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-region="feedback-modal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{modaltitle}}</h5>
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" data-region="status"></p>
                    <p class="text-muted small d-none" data-region="input-tokens"></p>
                    <label><strong>{{resultlabel}}</strong></label>
                    <textarea class="form-control" rows="10" data-region="feedback-text"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">{{#str}}closebutton, assignfeedback_aifeedback{{/str}}</button>
                    <button type="button" class="btn btn-primary" data-action="copy-feedback">{{copylabel}}</button>
                </div>
            </div>
        </div>
    </div>
</div>
